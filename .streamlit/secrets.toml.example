# GWS Security Auditor - Live Mode Configuration
# Copy this file to secrets.toml and populate with your service account credentials.
# NEVER commit secrets.toml to version control.

# Who may switch to live mode. Live mode reads the whole tenant through a
# super admin's delegated access, so only these signed-in addresses get the
# switch; everyone else sees Demo Mode. With this list missing or empty,
# nobody has live access. Keep this line above the [gws] table.
allowed_emails = [
    "REPLACE_WITH_USER_EMAIL",
]

[gws]
# Path to your service account JSON key file, OR paste the JSON content directly below.
# Option A: path on disk
# service_account_key_path = "/path/to/key.json"

# Option B: paste the full JSON as a multi-line string
# service_account_key_json = """
# {
#   "type": "service_account",
#   "project_id": "your-project-id",
#   "private_key_id": "...",
#   "private_key": "-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n",
#   "client_email": "auditor@your-project.iam.gserviceaccount.com",
#   "client_id": "...",
#   "auth_uri": "https://accounts.google.com/o/oauth2/auth",
#   "token_uri": "https://oauth2.googleapis.com/token"
# }
# """

# The GWS super admin account to impersonate via domain-wide delegation
admin_email = "admin@yourdomain.com"

# Your primary domain
domain = "yourdomain.com"

# Required OAuth scopes for the service account:
# - https://www.googleapis.com/auth/admin.directory.user.readonly
# - https://www.googleapis.com/auth/admin.directory.group.readonly
# - https://www.googleapis.com/auth/admin.reports.audit.readonly

# Sign-in for live mode: Streamlit's own OIDC sign-in (st.login); see
# https://docs.streamlit.io/develop/api-reference/user/st.login
#
# Running on your own machine without an identity provider:
#   GWS_AUDITOR_DEV_LOGIN_EMAIL=you@example.com streamlit run app.py --server.address localhost
# The variable is ignored unless the server is bound to localhost.
[auth]
redirect_uri = "REPLACE_WITH_APP_URL/oauth2callback"
cookie_secret = "REPLACE_WITH_LONG_RANDOM_STRING"
client_id = "REPLACE_WITH_OIDC_CLIENT_ID"
client_secret = "REPLACE_WITH_OIDC_CLIENT_SECRET"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
